# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/emergency_response"
DATABASE_CONNECTION_TIMEOUT=10000

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# ─── Resource allocation ─────────────────────────────────────────────────────
RESOURCE_AVERAGE_SPEED_KMH=60

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECTION_TIMEOUT=5000

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_MAX_ATTEMPTS=3
OUTBOX_POLL_INTERVAL_MS=5000

# ─── HTTP ────────────────────────────────────────────────────────────────────
HTTP_REQUEST_TIMEOUT=30000

# ─── Retry ───────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=100
RETRY_MAX_DELAY=5000

# ─── Circuit breaker ─────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ─── Graceful shutdown ────────────────────────────────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000

# ─── Idempotency ─────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS (comma-separated origins, or * for development only) ───────────────
CORS_ORIGINS=http://localhost:3000

# ─── Cleanup scheduler ───────────────────────────────────────────────────────
# How often the cleanup job runs (ms). Default: 6 hours
CLEANUP_INTERVAL_MS=21600000
# How many days to retain ProcessedEvent rows. Default: 7 days
PROCESSED_EVENT_RETENTION_DAYS=7

# ─── Cache (Part 12) ─────────────────────────────────────────────────────────
# Default TTL for cached responses in seconds. Default: 60 seconds
CACHE_DEFAULT_TTL_SECONDS=60

# ─── Worker Concurrency (Part 12) ────────────────────────────────────────────
# Number of BullMQ jobs processed in parallel per worker instance.
# Higher = more throughput but more DB connections consumed.
# Formula: WORKER_CONCURRENCY × (worker instances) ≤ PostgreSQL max_connections / 2
# Default: 5
WORKER_CONCURRENCY=5

# ─── Pagination (Part 12) ────────────────────────────────────────────────────
# Default number of records returned per page
PAGINATION_DEFAULT_LIMIT=20
# Maximum allowed limit to prevent runaway queries
PAGINATION_MAX_LIMIT=100

# ─── Load Testing (Part 12) ──────────────────────────────────────────────────
# Base URL for k6 load tests — NEVER use production URL
LOAD_TEST_BASE_URL=http://localhost:5000
# Test user credentials — use a dedicated test account only
LOAD_TEST_EMAIL=admin@test.local
LOAD_TEST_PASSWORD=TestPassword123!
